# /etc/sbs/server.env — environment for the sbs-server systemd unit.
# Install as root, owner-only:
#   sudo install -D -m 0600 deploy/server.env.example /etc/sbs/server.env
#   sudo ./scripts/gen-tokens.sh >> /etc/sbs/server.env   # or paste values below
# then `sudo chmod 600 /etc/sbs/server.env` and restart the service.

# Bearer token agents authenticate with (required). Generate with:
#   openssl rand -hex 32
SBS_AGENT_TOKEN=

# Operator/console login token (console-auth build — docs/CONSOLE_API.md).
SBS_CONSOLE_TOKEN=

# Only if ExecStart uses -llm anthropic:
# ANTHROPIC_API_KEY=
