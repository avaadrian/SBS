# Copy to .env and fill in strong, unique values. NEVER commit the real .env.
#
# Generate tokens with:
#   ./scripts/gen-tokens.sh          # writes a ready-to-use .env
# or by hand:
#   openssl rand -hex 32

# Bearer token agents use to authenticate to the server (required).
# Must match the token configured on each agent (server.token in agent.yaml).
SBS_AGENT_TOKEN=

# Operator/console login token. Used by the console-auth build (docs/CONSOLE_API.md).
# Leave blank only if you keep the console bound to localhost with no operator auth.
SBS_CONSOLE_TOKEN=

# Only needed if you run the server with -llm anthropic (Claude API triage).
# Leave blank for the default local Ollama analyst.
ANTHROPIC_API_KEY=

# Optional: image tag / version stamp used by docker-compose.
SBS_VERSION=local
